    "block_domains": [
      "d1234.cc", "77ttrry.com", "77ttvvyy.com", "vip1234.top", "bcvcd.cc", "cp955.cc",
      "wujincp.com", "0088445.com", "ff1515.net", "amvnb.com", "xhztv.top"
    ],
    "block_regex": [
      "(百家乐|澳门威尼斯人|凯旋门|新?葡京|太阳城).{0,6}(官网|平台|开户|娱乐城)",
      "(体育|足球|电竞).{0,4}(投注|盘口)",
      "(棋牌|捕鱼|牛牛|金花|开元|十三张).{0,4}(游戏|平台|大厅|真人|赢|送|红包)",
      "(cp|caipiao|lottery|baccarat)[0-9]{0,3}\\.(com|net|top|cc|vip)$"
